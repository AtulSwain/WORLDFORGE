# ─────────────────────────────────────────────────────────────
# WorldForge environment. Copy to `.env` and adjust.
# Never commit real secrets; `.env` is git-ignored.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection (required).
DATABASE_URL="postgresql://worldforge:worldforge@localhost:5432/worldforge"

# Disposable database for integration tests (`npm run test:integration`).
# Must be different from DATABASE_URL — the tests create and delete data.
DATABASE_URL_TEST="postgresql://worldforge:worldforge@localhost:5432/worldforge_test"

# Public base URL of the app; used to build invitation links.
APP_URL="http://localhost:3000"

# ── AI (optional) ────────────────────────────────────────────
# none (default) | demo | anthropic | openai-compatible
#   none   – AI features show a clear "unavailable" state; everything else works.
#   demo   – deterministic, clearly-labelled sample outputs; no network, no key.
AI_PROVIDER="none"
# Required for anthropic / openai-compatible: the model ID to call.
AI_MODEL=""
# Required for anthropic / openai-compatible. Server-side only; never sent to browsers.
AI_API_KEY=""
# openai-compatible only (defaults to https://api.openai.com/v1).
AI_BASE_URL=""
# Guard rails.
AI_TIMEOUT_MS="45000"
AI_MAX_RETRIES="2"
AI_MAX_OUTPUT_TOKENS="2048"
AI_DAILY_TOKEN_LIMIT="200000"
AI_MAX_CONTEXT_CHARS="24000"

# ── File storage ─────────────────────────────────────────────
# local (default) stores uploads on disk; s3 uses any S3-compatible service
# (AWS S3, Cloudflare R2, MinIO, Backblaze B2…).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
MAX_UPLOAD_MB="10"
# Required when STORAGE_DRIVER=s3.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# "true" for MinIO and most self-hosted services.
S3_FORCE_PATH_STYLE="false"
